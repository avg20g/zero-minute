get 'https://commons.wikimedia.org/wiki/Special:FilePath/2S19M2_Msta-S.jpg' '42_inferno-cannon_general.jpg'
get 'https://commons.wikimedia.org/wiki/Special:FilePath/Mikoyan_MiG-29_3-view.svg' '43_mig-strike-fighter_3-view-vector-drawing.svg'
get 'https://commons.wikimedia.org/wiki/Special:FilePath/Mikoyan_MiG-29_3-view_line_drawing.png' '44_mig-strike-fighter_3-view.png'
get 'https://commons.wikimedia.org/wiki/Special:FilePath/Suchoi_Su-25_0801.png' '45_mig-strike-fighter_3-view-line-drawing.png'
get 'https://commons.wikimedia.org/wiki/Special:FilePath/Russian_Sukhoi_Su-25_at_Latakia_(2).jpg' '46_mig-strike-fighter_on-the-ramp.jpg'
get 'https://commons.wikimedia.org/wiki/Special:FilePath/Mil_Mi-24,_Russia_-_Air_Force_AN1267493.jpg' '47_helicopter-not-in-game-yet_general.jpg'
get 'https://commons.wikimedia.org/wiki/Special:FilePath/Mil_Mi-28_(4322158290).jpg' '48_helicopter-not-in-game-yet_general.jpg'
get 'https://commons.wikimedia.org/wiki/Special:FilePath/RT-2PM2_Topol-M-14.jpg' '49_nuclear-missile-silo_general.jpg'
get 'https://commons.wikimedia.org/wiki/Special:FilePath/OLDSOVIETAIRBASE.jpg' '50_nuclear-missile-silo_ground-view.jpg'
get 'https://commons.wikimedia.org/wiki/Special:FilePath/Fast_attack_vehicle_(FAV).jpg' '51_rocket-buggy_clean-left-side.jpg'
get 'https://commons.wikimedia.org/wiki/Special:FilePath/Fast_Attack_Vehicle_01.jpg' '52_rocket-buggy_museum.jpg'
get 'https://commons.wikimedia.org/wiki/Special:FilePath/Chenowth_desert_patrol_vehicle_DPV_pic1.JPG' '53_rocket-buggy_walk-around.jpg'
get 'https://commons.wikimedia.org/wiki/Special:FilePath/M1040_Hellfire_Chenowth_fast_attak_vehicle_pic2.JPG' '54_rocket-buggy_missile-armed-variant.jpg'
