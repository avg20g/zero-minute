get 'https://commons.wikimedia.org/wiki/Special:FilePath/T-90A_front_Army-2016.jpg' '33_battle-tank-overlord-heavy-t_front-detail.jpg'
get 'https://commons.wikimedia.org/wiki/Special:FilePath/T-90A_12april_Alabino_01.jpg' '34_battle-tank-overlord-heavy-t_parade-rehearsal.jpg'
get 'https://commons.wikimedia.org/wiki/Special:FilePath/ZTZ-99A_tank_front_right_20170902.jpg' '35_battle-tank-overlord-heavy-t_front-three-quarter.jpg'
get 'https://commons.wikimedia.org/wiki/Special:FilePath/ZTZ-99A_tank_front_20170902.jpg' '36_battle-tank-overlord-heavy-t_straight-front.jpg'
