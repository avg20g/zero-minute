#!/bin/bash
# Downloads every reference photo into the "photos" folder next to this script.
cd "$(dirname "$0")" && mkdir -p photos && cd photos || exit 1
get() { [ -s "$2" ] || curl -L --fail -sS -A "ZeroMinuteRefs/1.0 (personal 3D reference)" -o "$2" "$1" || echo "FAILED: $2"; sleep 1; }
get 'https://commons.wikimedia.org/wiki/Special:FilePath/Marine_sniper_ghillie_suit.JPG' '01_pathfinder-sniper_three-quarter-moving.jpg'
get 'https://commons.wikimedia.org/wiki/Special:FilePath/One_Shot,_Marines,_JGSDF_complete_sniper_training_141202-M-GX711-042.jpg' '02_pathfinder-sniper_prone-low-crawl.jpg'
get 'https://commons.wikimedia.org/wiki/Special:FilePath/Camouflaged-sniper.jpg' '03_pathfinder-sniper_two-man-team-lying-in-.jpg'
get 'https://commons.wikimedia.org/wiki/Special:FilePath/Ghillie_suit_march,_Advanced_Sniper_training_at_ISTC_(13714767214).jpg' '04_pathfinder-sniper_standing-walking-group.jpg'
get 'https://commons.wikimedia.org/wiki/Special:FilePath/M1_Abrams_diagram_num.svg' '05_abrams-main-battle-tank_side-profile-line-diag.svg'
get 'https://commons.wikimedia.org/wiki/Special:FilePath/M1_Abrams_at_the_US_Army_Armor_Center,_1983_(DA-SC-83-09878).jpg' '06_abrams-main-battle-tank_clean-right-side.jpg'
get 'https://commons.wikimedia.org/wiki/Special:FilePath/DA-ST-86-00221_right_side_view_of_three_M1_Abrams_in_a_firing_line_during_Exercise_Reforger_%2785.jpeg' '07_abrams-main-battle-tank_right-side-in-formatio.jpeg'
get 'https://commons.wikimedia.org/wiki/Special:FilePath/M1A2_SEP_V3_Abrams.jpg' '08_abrams-main-battle-tank_three-quarter.jpg'
get 'https://commons.wikimedia.org/wiki/Special:FilePath/U.S._Army_M1A2_Abrams_at_Tal_Afar.jpg' '09_abrams-main-battle-tank_front-three-quarter.jpg'
get 'https://commons.wikimedia.org/wiki/Special:FilePath/Abrams-transparent.png' '10_abrams-main-battle-tank_side-cut-out.png'
get 'https://commons.wikimedia.org/wiki/Special:FilePath/Avenger_missile.jpg' '11_avenger-laser-tank_three-quarter.jpg'
get 'https://commons.wikimedia.org/wiki/Special:FilePath/Avenger_Stinger_Missile.JPEG' '12_avenger-laser-tank_firing.jpeg'
get 'https://commons.wikimedia.org/wiki/Special:FilePath/M1097_Avenger_AA-System.jpg' '13_avenger-laser-tank_front-three-quarter.jpg'
get 'https://commons.wikimedia.org/wiki/Special:FilePath/Stryker_DE_M-SHORAD.jpg' '14_avenger-laser-tank_three-quarter-field.jpg'
get 'https://commons.wikimedia.org/wiki/Special:FilePath/M1151_HMMWV.jpg' '15_humvee-dozer_general.jpg'
get 'https://commons.wikimedia.org/wiki/Special:FilePath/IDF-D9R-Armored-Bulldozer-ZEMK-002.jpg' '16_humvee-dozer_general.jpg'
get 'https://commons.wikimedia.org/wiki/Special:FilePath/RAH-66_cpcomcut.gif' '17_comanche-gunship_side-cutaway-drawing.gif'
get 'https://commons.wikimedia.org/wiki/Special:FilePath/RAH-66_Comanche_prototype.jpg' '18_comanche-gunship_prototype.jpg'
get 'https://commons.wikimedia.org/wiki/Special:FilePath/Rah-66_c._2000.jpg' '19_comanche-gunship_in-flight.jpg'
get 'https://commons.wikimedia.org/wiki/Special:FilePath/Rah-66_w_apache_02.jpg' '20_comanche-gunship_with-ah-64-behind.jpg'
get 'https://commons.wikimedia.org/wiki/Special:FilePath/AH-64E_Apache-Guardian-0006.jpg' '21_comanche-gunship_take-off.jpg'
get 'https://commons.wikimedia.org/wiki/Special:FilePath/0420-0905-2610-5004_paratrooper_jumping_out_of_an_airplane_o.jpg' '22_paratrooper-drop_exit-from-tail-gate.jpg'
get 'https://commons.wikimedia.org/wiki/Special:FilePath/A_left_underside_view_of_a_C-130_Hercules_aircraft_as_a_paratropper_is_air_dropped_during_Exercise_VOLANT_RODEO_-_DPLA_-_dbc80607c8c35906b711e431c0d807b8.jpeg' '23_paratrooper-drop_underside-left.jpeg'
get 'https://commons.wikimedia.org/wiki/Special:FilePath/C-130_Hercules_performs_a_tactical_landing_on_a_dirt_strip.jpg' '24_paratrooper-drop_side-landing.jpg'
